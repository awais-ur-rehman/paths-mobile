{
  "version": 8,
  "name": "Paths Light",
  "metadata": {
    "paths:author": "Original Paths styling; OpenMapTiles schema, OpenFreeMap public tiles"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\">OpenFreeMap</a> \u00a9 <a href=\"https://openmaptiles.org\">OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F5F5F3"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#DDE8CA",
        "fill-opacity": 0.65
      },
      "filter": [
        "in",
        "class",
        "wood",
        "grass",
        "scrub"
      ]
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#BBD87D"
      },
      "filter": [
        "in",
        "class",
        "park",
        "recreation_ground",
        "village_green",
        "garden",
        "cemetery"
      ]
    },
    {
      "id": "park-boundaries",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#BBD87D",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#7BCED5"
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#7BCED5",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          16,
          4
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#E1E3E3",
        "fill-outline-color": "#E1E3E3"
      },
      "minzoom": 13
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.6,
          12,
          3,
          15,
          10,
          18,
          28
        ]
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "filter": [
        "!in",
        "class",
        "rail",
        "transit",
        "path"
      ]
    },
    {
      "id": "paths",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.5,
          17,
          3
        ]
      },
      "filter": [
        "==",
        "class",
        "path"
      ]
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#D1D6D8",
        "line-width": 1,
        "line-dasharray": [
          2,
          3
        ]
      },
      "filter": [
        "in",
        "class",
        "rail",
        "transit"
      ]
    },
    {
      "id": "road-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "paint": {
        "text-color": "#78858A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.5
      },
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-angle": 30
      },
      "minzoom": 14
    },
    {
      "id": "place-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "paint": {
        "text-color": "#536B73",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.5
      },
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          11,
          14,
          15
        ],
        "text-max-width": 8
      }
    }
  ]
}
