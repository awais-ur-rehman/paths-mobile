  "info": {
    "title": "Paths API",
    "description": "",
    "version": "1.3.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "contractVersion": {
            "type": "string",
            "enum": [
              "1.3.0"
            ]
          }
        },
        "required": [
          "status",
          "contractVersion"
        ]
      },
      "ErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "accountStatus": {
            "type": "string",
            "enum": [
              "active",
              "deactivated"
            ]
          },
          "setupStage": {
            "type": "string",
            "enum": [
              "adult",
              "profile"
            ]
          },
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "accessExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "userId",
          "email",
          "name",
          "accountStatus",
          "setupStage",
          "accessToken",
          "refreshToken",
          "accessExpiresAt",
          "refreshExpiresAt"
        ]
      },
      "ResetGrantDto": {
        "type": "object",
        "properties": {
          "resetToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "resetToken",
          "expiresAt"
        ]
      },
      "AuthConfigDto": {
        "type": "object",
        "properties": {
          "supportEmail": {
            "type": "string"
          },
          "termsUrl": {
            "type": "string"
          },
          "privacyUrl": {
            "type": "string"
          }
        },
        "required": [
          "supportEmail",
          "termsUrl",
          "privacyUrl"
        ]
      },
      "SignupInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "termsAccepted": {
            "type": "boolean",
            "description": "Terms acceptance must be true."
          }
        },
        "required": [
          "email",
          "password",
          "name",
          "termsAccepted"
        ]
      },
      "ChallengeDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "signup",
              "reset"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "resendAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "challengeId",
          "purpose",
          "expiresAt",
          "resendAt"
        ]
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "EmailInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "ChallengeInput": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "challengeId"
        ]
      },
      "VerifyInput": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "signup",
              "reset"
            ]
          }
        },
        "required": [
          "challengeId",
          "code",
          "purpose"
        ]
      },
      "RefreshInput": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "AcknowledgedDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ResetInput": {
        "type": "object",
        "properties": {
          "resetToken": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "resetToken",
          "password"
        ]
      },
      "AccountDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "accountStatus": {
            "type": "string",
            "enum": [
              "active",
              "deactivated"
            ]
          },
          "setupStage": {
            "type": "string",
            "enum": [
              "adult",
              "profile"
            ]
          }
        },
        "required": [
          "userId",
          "email",
          "name",
          "accountStatus",
          "setupStage"
        ]
      },
      "AdultInput": {
        "type": "object",
        "properties": {
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "dateOfBirth"
        ]
      },
      "ProfileDetailsDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "gender": {
            "type": "string",
            "enum": [
              "",
              "man",
              "woman",
              "another_identity",
              "prefer_not_to_say"
            ]
          },
          "bio": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "public"
            ]
          },
          "profileComplete": {
            "type": "boolean",
            "description": "Details alone do not complete photo/verification setup."
          }
        },
        "required": [
          "username",
          "name",
          "gender",
          "bio",
          "visibility",
          "profileComplete"
        ]
      },
      "ProfileDetailsInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 24,
            "pattern": "^[a-z0-9_]{3,24}$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "gender": {
            "type": "string",
            "enum": [
              "man",
              "woman",
              "another_identity",
              "prefer_not_to_say"
            ]
          },
          "bio": {
            "type": "string",
            "maxLength": 300
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "public"
            ]
          }
        },
        "required": [
          "username",
          "name",
          "gender",
          "bio"
        ]
      },
      "ProfileSummaryDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "age": {
            "type": "number",
            "minimum": 18
          },
          "gender": {
            "type": "string",
            "enum": [
              "man",
              "woman",
              "another_identity",
              "prefer_not_to_say"
            ]
          },
          "bio": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "public"
            ]
          },
          "verificationStatus": {
            "type": "string",
            "enum": [
              "none",
              "pending",
              "approved",
              "declined"
            ]
          },
          "photoState": {
            "type": "string",
            "enum": [
              "unavailable"
            ]
          }
        },
        "required": [
          "userId",
          "username",
          "name",
          "age",
          "gender",
          "bio",
          "visibility",
          "verificationStatus",
          "photoState"
        ]
      },
      "VerificationDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "none",
              "pending",
              "approved",
              "declined"
            ]
          },
          "offerSeen": {
            "type": "boolean"
          },
          "uploadsAvailable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "status",
          "offerSeen",
          "uploadsAvailable",
          "reason"
        ]
      },
      "VerificationInput": {
        "type": "object",
        "properties": {
          "frontAssetId": {
            "type": "string",
            "format": "uuid"
          },
          "backAssetId": {
            "type": "string",
            "format": "uuid"
          },
          "consent": {
            "type": "boolean",
            "description": "Consent must be true."
          }
        },
        "required": [
          "frontAssetId",
          "consent"
        ]
      }
    }
  }
}
